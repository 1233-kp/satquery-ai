# ── Core ──────────────────────────────────────────────
APP_ENV=development
DATABASE_URL=sqlite:///./satquery.db
UPLOAD_DIR=./data/uploads
RESULTS_DIR=./data/results
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Model mode ───────────────────────────────────────
# "real"  -> load actual models (needs GPU/CPU + weights)
# "mock"  -> deterministic stub outputs, useful for wiring up UI fast
VQA_MODE=mock
CHANGE_MODE=mock
FUSION_MODE=mock

# ── VQA Model ────────────────────────────────────────
VQA_BASE_MODEL=HuggingFaceTB/SmolVLM-500M-Instruct
VQA_LORA_PATH=./checkpoints/vqa_lora/best
VQA_DEVICE=cpu
VQA_MAX_NEW_TOKENS=256

# ── Change Detection ─────────────────────────────────
CHANGE_DETECTION_CHECKPOINT=./checkpoints/change_unet/best_model.pt

# ── Optical+SAR Fusion ────────────────────────────────
FUSION_CHECKPOINT=./checkpoints/fusion_net/best_model.pt

# ── Auth ──────────────────────────────────────────────
# Sign a random 32+ byte string for this, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret
# From Google Cloud Console -> APIs & Services -> Credentials (OAuth client ID, type "Web application").
# Authorized redirect URI must be exactly: {your backend URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# From GitHub -> Settings -> Developer settings -> OAuth Apps.
# Authorization callback URL must be exactly: {your backend URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where OAuth callbacks redirect back to after issuing a token.
FRONTEND_URL=http://localhost:5173
